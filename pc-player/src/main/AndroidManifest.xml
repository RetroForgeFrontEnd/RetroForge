<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Windows runtime (Wine, FEX, a Linux image) is downloaded on first use. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Steam game downloads: a background service with a progress notification, keeping Wi-Fi and the CPU awake. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Whether the device is on Wi-Fi, for Wi-Fi-only Steam downloads. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Play together: the game keeps its network connection while the player looks at another app. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-feature android:glEsVersion="0x00030000" android:required="false" />

    <application>
        <!-- Its own process: Wine runs as child processes of it, and quitting ends them all. -->
        <activity
            android:name="com.retroforge.pcplayer.PcPlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize|density"
            android:exported="false"
            android:process=":pcplayer"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
        <!-- Its own process: a big download needs the memory, and can't take the rest of the app down with it. The PC
             tab follows it through a small status file. -->
        <service
            android:name="com.retroforge.pcplayer.steam.SteamDownloadService"
            android:exported="false"
            android:process=":steamdownload"
            android:foregroundServiceType="dataSync" />
        <!-- Play together: keeps the player's process (the game and its virtual LAN) running in the background. -->
        <service
            android:name="com.retroforge.pcplayer.net.PlayTogetherService"
            android:exported="false"
            android:process=":pcplayer"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a multiplayer PC game's network connection to the other players open while the player is briefly in another app" />
        </service>
    </application>
</manifest>
