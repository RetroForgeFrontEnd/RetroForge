<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.droiddeck.launcher" />
        <!-- Native ports with a known package name (ports.json), so the PC tab can offer "Open" once installed. -->
        <package android:name="com.dishii.zelda3" />
        <package android:name="org.diasurgical.devilutionx" />
        <intent>
            <action android:name="com.droiddeck.launcher.LAUNCH_GAME" />
        </intent>
    </queries>
</manifest>
